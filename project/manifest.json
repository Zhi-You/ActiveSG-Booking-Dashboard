{
  "manifest_version": 3,
  "name": "ActiveSG Booking Dashboard",
  "version": "2.6.1",
  "description": "Personal read-only time × venue grid on ActiveSG after you log in. Never books anything.",
  "host_permissions": ["https://activesg.gov.sg/*"],
  "content_scripts": [
    {
      "matches": ["https://activesg.gov.sg/*"],
      "js": ["spy.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://activesg.gov.sg/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ]
}
