# Your normal ActiveSG login credentials
ACTIVESG_EMAIL=you@example.com
ACTIVESG_PASSWORD=your_password_here

# Port the local API server listens on
PORT=4000

# How long aggregated availability results are cached, in milliseconds.
# Lower = fresher data but more requests to ActiveSG. 2 minutes is a reasonable
# balance for "near real-time" without hammering their servers.
CACHE_TTL_MS=120000

# Max number of venues queried in parallel during a fan-out. Keep this modest
# to avoid looking like abusive traffic to ActiveSG.
FANOUT_CONCURRENCY=6
